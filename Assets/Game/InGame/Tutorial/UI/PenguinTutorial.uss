.screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    overflow: hidden;
    color: #153950;
    -unity-font-definition: url("../../UI/MissionHUD/Fonts/Jua-Regular.ttf");
}

.ticket-stamp,
.step-counter,
.key-badge,
.legend-title,
.clear-badge-text,
.complete-kicker {
    -unity-font-definition: url("../../../Core/UI/Fonts/LilitaOne-Regular.ttf");
}

.top-strip {
    display: none;
    position: absolute;
    top: 24px;
    left: 50%;
    translate: -50% 0;
    width: 348px;
    height: 42px;
}

.top-strip-shadow,
.top-strip-paper {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    border-radius: 8px;
}

.top-strip-shadow {
    background-color: rgba(11, 38, 56, 0.88);
    translate: 5px 6px;
}

.top-strip-paper {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding-left: 18px;
    padding-right: 18px;
    background-color: #f8f5ea;
    border-width: 3px;
    border-color: #ffffff;
}

.step-dot {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background-color: #b9d5da;
    border-width: 3px;
    border-color: #153950;
    transition-property: width, height, background-color;
    transition-duration: 0.16s;
}

.step-dot--active {
    width: 20px;
    height: 20px;
    border-radius: 10px;
    background-color: #ffd35a;
    border-color: #153950;
}

.step-dot--done {
    background-color: #63d6c1;
    border-color: #208457;
}

.step-line {
    width: 35px;
    height: 4px;
    background-color: #b9d5da;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: #ffffff;
}

.tutorial-card {
    position: absolute;
    left: 36px;
    top: 34px;
    width: 460px;
    height: 256px;
    transition-property: scale;
    transition-duration: 0.18s;
    transform-origin: left top;
}

.ticket-shadow,
.ticket-paper {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    border-radius: 7px;
}

.ticket-shadow {
    background-color: rgba(11, 38, 56, 0.9);
    translate: 7px 8px;
}

.ticket-paper {
    padding: 17px 20px 14px 20px;
    background-color: #faf7ee;
    border-width: 4px;
    border-color: #ffffff;
    overflow: hidden;
}

.ticket-accent {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 10px;
    background-color: #2f83cf;
    border-right-width: 4px;
    border-right-color: #1c62a5;
}

.tutorial-card--success {
    scale: 1.025 1.025;
}

.tutorial-card--success .ticket-accent {
    background-color: #63d6c1;
    border-right-color: #208457;
}

.tutorial-card--success .progress-fill {
    background-color: #31b478;
}

.clear-badge {
    display: none;
    position: absolute;
    right: -18px;
    top: -19px;
    height: 48px;
    flex-direction: row;
    align-items: center;
    padding-left: 12px;
    padding-right: 15px;
    color: #ffffff;
    background-color: #31b478;
    border-width: 4px;
    border-color: #ffffff;
    border-radius: 9px;
    rotate: 3deg;
    opacity: 0;
}

.clear-badge-check {
    width: 28px;
    color: #ffffff;
    font-size: 25px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.clear-badge-text {
    color: #ffffff;
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}

.ticket-header {
    height: 26px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.ticket-stamp {
    padding: 3px 9px 2px 9px;
    color: #f8f5ea;
    background-color: #153950;
    border-radius: 4px;
    font-size: 13px;
    letter-spacing: 1px;
}

.step-counter {
    color: #2f83cf;
    font-size: 16px;
    letter-spacing: 1px;
}

.ticket-rule {
    height: 3px;
    margin-top: 7px;
    margin-bottom: 7px;
    background-color: #b9d5da;
    border-radius: 2px;
}

.step-title {
    height: 36px;
    color: #153950;
    font-size: 28px;
    -unity-font-style: normal;
    -unity-text-align: middle-left;
}

.instruction-row {
    height: 72px;
    flex-direction: row;
    align-items: center;
    margin-top: 3px;
    margin-bottom: 6px;
}

.key-shadow {
    width: 112px;
    min-width: 112px;
    height: 47px;
    flex-shrink: 0;
    margin-right: 15px;
    background-color: #0b2638;
    border-radius: 9px;
    translate: 3px 5px;
    transition-property: scale, background-color;
    transition-duration: 0.16s;
}

.key-shadow--wide {
    width: 140px;
    min-width: 140px;
}

.key-badge {
    position: absolute;
    left: -3px;
    right: 3px;
    top: -5px;
    bottom: 5px;
    padding: 6px 11px 8px 11px;
    color: #153950;
    background-color: #ffd35a;
    border-width: 3px;
    border-color: #ffffff;
    border-bottom-width: 6px;
    border-bottom-color: #d89522;
    border-radius: 8px;
    font-size: 20px;
    -unity-text-align: middle-center;
    transition-property: background-color, border-bottom-color;
    transition-duration: 0.16s;
}

.key-badge--wide {
    padding-left: 8px;
    padding-right: 8px;
    font-size: 16px;
    letter-spacing: 0;
    white-space: nowrap;
}

.instruction {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    color: #0b2638;
    max-height: 48px;
    font-size: 17px;
    line-height: 22px;
    -unity-font-style: normal;
    white-space: normal;
}

.key-shadow--attention {
    scale: 1.06 1.06;
    background-color: #7c5310;
}

.key-badge--attention {
    background-color: #fff0a6;
    border-bottom-color: #ef9e18;
}

.progress-track {
    height: 13px;
    background-color: #d8e3e2;
    border-width: 3px;
    border-color: #153950;
    border-radius: 7px;
    overflow: hidden;
}

.progress-fill {
    width: 0%;
    height: 100%;
    background-color: #63d6c1;
    border-right-width: 3px;
    border-right-color: #2aae9a;
    transition-property: width, background-color;
    transition-duration: 0.12s;
}

.progress-text {
    height: 20px;
    color: #294c5e;
    font-size: 16px;
    -unity-font-style: normal;
    -unity-text-align: middle-right;
    margin-top: 3px;
}

.control-legend {
    display: none;
    position: absolute;
    right: 28px;
    bottom: 25px;
    width: 316px;
    height: 148px;
}

.legend-shadow,
.legend-paper {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    border-radius: 7px;
}

.legend-shadow {
    background-color: rgba(11, 38, 56, 0.86);
    translate: 6px 7px;
}

.legend-paper {
    padding: 13px 17px;
    background-color: #faf7ee;
    border-width: 3px;
    border-color: #ffffff;
}

.legend-title {
    align-self: flex-start;
    padding: 2px 8px;
    color: #f8f5ea;
    background-color: #f15b62;
    border-bottom-width: 3px;
    border-bottom-color: #b63d49;
    border-radius: 4px;
    font-size: 14px;
    letter-spacing: 1px;
    margin-bottom: 4px;
}

.legend-row {
    color: #173247;
    font-size: 13px;
    margin-top: 2px;
}

.complete-card {
    display: none;
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 570px;
    height: 256px;
}

.complete-shadow,
.complete-paper {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    border-radius: 8px;
}

.complete-shadow {
    background-color: rgba(11, 38, 56, 0.92);
    translate: 9px 10px;
}

.complete-paper {
    align-items: center;
    justify-content: center;
    padding: 30px 42px 26px 42px;
    background-color: #faf7ee;
    border-width: 5px;
    border-color: #ffffff;
    overflow: hidden;
}

.complete-accent {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 12px;
    background-color: #31b478;
    border-bottom-width: 4px;
    border-bottom-color: #208457;
}

.complete-kicker {
    padding: 4px 13px 3px 13px;
    color: #f8f5ea;
    background-color: #208457;
    border-radius: 4px;
    font-size: 16px;
    letter-spacing: 2px;
}

.complete-title {
    color: #153950;
    font-size: 44px;
    -unity-font-style: bold;
    margin-top: 7px;
}

.complete-rule {
    width: 100%;
    margin-top: 5px;
    margin-bottom: 10px;
}

.complete-copy {
    color: #557381;
    font-size: 18px;
    white-space: normal;
    -unity-text-align: middle-center;
}
