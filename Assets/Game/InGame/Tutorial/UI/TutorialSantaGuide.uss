.santa-guide-screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    overflow: hidden;
    -unity-font-definition: url("../../UI/MissionHUD/Fonts/NotoSansKR-Variable.ttf");
}

.santa-guide {
    position: absolute;
    right: 28px;
    bottom: 26px;
    width: 548px;
    height: 184px;
    opacity: 0;
    translate: 0 28px;
    transition-property: opacity, translate;
    transition-duration: 0.22s, 0.28s;
    transition-timing-function: ease-out, ease-out;
}

.santa-guide--visible {
    opacity: 1;
    translate: 0 0;
}

.santa-guide-shadow,
.santa-guide-body {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    border-radius: 14px;
}

.santa-guide-shadow {
    translate: 7px 8px;
    background-color: rgba(7, 22, 35, 0.72);
}

.santa-guide-body {
    flex-direction: row;
    align-items: center;
    padding: 12px 18px 12px 12px;
    background-color: rgba(247, 241, 220, 0.97);
    border-width: 4px;
    border-color: #f8fbef;
}

.santa-portrait {
    width: 154px;
    height: 154px;
    flex-shrink: 0;
    border-radius: 77px;
    border-width: 4px;
    border-color: #d9584d;
    -unity-background-scale-mode: scale-and-crop;
    background-position-x: 38%;
    background-position-y: 38%;
}

.santa-portrait-ring {
    position: absolute;
    left: 5px;
    right: 5px;
    top: 5px;
    bottom: 5px;
    border-radius: 72px;
    border-width: 2px;
    border-color: rgba(255, 224, 149, 0.92);
}

.santa-copy {
    flex-grow: 1;
    height: 144px;
    margin-left: 17px;
    padding-top: 9px;
}

.santa-eyebrow {
    height: 22px;
    color: #3a7c91;
    font-size: 12px;
    letter-spacing: 1.2px;
    -unity-font-style: bold;
}

.santa-title {
    height: 37px;
    color: #19394a;
    font-size: 25px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.santa-message {
    height: 70px;
    padding-top: 5px;
    color: #405e68;
    font-size: 16px;
    white-space: normal;
}

.santa-tail {
    position: absolute;
    right: 34px;
    bottom: -17px;
    width: 36px;
    height: 28px;
    rotate: 45deg;
    background-color: rgba(247, 241, 220, 0.97);
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-color: #f8fbef;
}
