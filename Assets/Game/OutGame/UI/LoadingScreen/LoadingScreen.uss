.loading-screen {
    flex-grow: 1;
    background-color: #17384c;
    overflow: hidden;
    -unity-font-definition: url("../../../Core/UI/Fonts/LilitaOne-Regular.ttf");
}

.background-decor {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    overflow: hidden;
}

.decor-orb,
.decor-ring,
.decor-swoosh,
.decor-stripes,
.decor-sparkle,
.decor-dot {
    position: absolute;
}

.decor-orb-glow {
    left: 19%;
    top: -22%;
    width: 62%;
    height: 66%;
    background-color: rgba(79, 139, 160, 0.13);
    border-radius: 9999px;
}

.decor-ring {
    border-width: 0;
    border-radius: 9999px;
}

.decor-ring-a {
    left: -9%;
    bottom: -21%;
    width: 50%;
    height: 35%;
    background-color: #edf6f7;
    rotate: 3deg;
}

.decor-ring-b {
    right: -13%;
    bottom: -22%;
    width: 62%;
    height: 39%;
    background-color: #d8eaee;
    rotate: -4deg;
}

.decor-ring-c {
    left: 27%;
    bottom: -29%;
    width: 50%;
    height: 39%;
    background-color: #f8fcfb;
}

.decor-ring-d {
    right: 8%;
    top: 8%;
    width: 56px;
    height: 56px;
    background-color: #f1c969;
    border-width: 5px;
    border-color: rgba(255, 255, 255, 0.84);
}

.decor-ring-e {
    right: 13%;
    bottom: 27%;
    width: 13px;
    height: 13px;
    background-color: rgba(239, 249, 250, 0.8);
}

.decor-swoosh {
    width: 520px;
    height: 120px;
    border-radius: 9999px;
    rotate: -9deg;
}

.decor-swoosh-a {
    left: -92px;
    top: 19%;
    border-top-width: 8px;
    border-top-color: rgba(205, 235, 241, 0.2);
}

.decor-swoosh-b {
    right: -130px;
    top: 38%;
    border-top-width: 5px;
    border-top-color: rgba(230, 247, 249, 0.14);
}

.decor-stripes {
    width: 176px;
    height: 70px;
    rotate: -9deg;
}

.decor-stripes-a {
    left: 8%;
    top: 11%;
}

.decor-stripes-b {
    right: 9%;
    top: 29%;
    scale: 0.82 0.82;
}

.decor-stripes-c {
    left: 12%;
    bottom: 25%;
    scale: 0.68 0.68;
}

.decor-stripe {
    position: absolute;
    left: 0;
    width: 150px;
    height: 5px;
    background-color: rgba(214, 239, 244, 0.2);
    border-radius: 999px;
}

.decor-stripe-0 {
    top: 0;
}

.decor-stripe-1 {
    top: 18px;
    left: 28px;
    width: 112px;
}

.decor-stripe-2 {
    top: 36px;
    left: 8px;
    width: 132px;
}

.decor-stripe-3 {
    top: 54px;
    left: 48px;
    width: 86px;
}

.decor-sparkle {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    rotate: 45deg;
    background-color: rgba(244, 251, 251, 0.88);
}

.decor-sparkle-a {
    left: 18%;
    top: 18%;
    width: 8px;
    height: 8px;
}

.decor-sparkle-b {
    right: 19%;
    top: 21%;
    width: 11px;
    height: 11px;
}

.decor-sparkle-c {
    right: 7%;
    top: 54%;
    width: 7px;
    height: 7px;
    opacity: 0.66;
}

.decor-sparkle-d {
    left: 6%;
    top: 43%;
    width: 12px;
    height: 12px;
    opacity: 0.72;
}

.decor-dot {
    border-radius: 999px;
}

.decor-dot-a {
    left: 4.5%;
    top: 56%;
    width: 16px;
    height: 16px;
    background-color: #f1c969;
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.72);
}

.decor-dot-b {
    right: 27%;
    top: 13%;
    width: 7px;
    height: 7px;
    background-color: rgba(239, 249, 250, 0.7);
}

.animation-stage {
    position: absolute;
    left: 0;
    right: 0;
    top: 8%;
    height: 65%;
    overflow: visible;
}

.snowball {
    position: absolute;
    left: -64px;
    bottom: 38px;
    width: 128px;
    height: 128px;
    background-color: #f5fbfc;
    border-width: 7px;
    border-color: #ffffff;
    border-radius: 9999px;
    overflow: hidden;
    transform-origin: 50% 50%;
}

.snowball-patch,
.snowball-highlight {
    position: absolute;
    border-radius: 9999px;
}

.snowball-patch {
    background-color: #d6e9ed;
    border-width: 3px;
    border-color: rgba(173, 207, 216, 0.7);
}

.snowball-patch-a {
    left: 18px;
    top: 61px;
    width: 35px;
    height: 24px;
    rotate: 18deg;
}

.snowball-patch-b {
    right: 14px;
    top: 28px;
    width: 25px;
    height: 36px;
    rotate: -24deg;
}

.snowball-patch-c {
    right: 33px;
    bottom: 14px;
    width: 19px;
    height: 15px;
}

.snowball-highlight {
    left: 25px;
    top: 19px;
    width: 31px;
    height: 17px;
    background-color: rgba(255, 255, 255, 0.94);
    rotate: -24deg;
}

.snowball-shadow {
    position: absolute;
    left: -64px;
    bottom: 25px;
    width: 128px;
    height: 18px;
    background-color: rgba(8, 28, 42, 0.32);
    border-radius: 9999px;
}

.snow-spray {
    position: absolute;
    left: 0;
    bottom: 6px;
    width: 235px;
    height: 150px;
    opacity: 0;
    overflow: visible;
}

.snow-arc {
    position: absolute;
    left: 0;
    top: 0;
    width: 74px;
    height: 8px;
    background-color: rgba(244, 251, 251, 0.94);
    border-radius: 999px;
    opacity: 0;
}

.snow-arc-b {
    width: 58px;
    height: 6px;
    background-color: rgba(201, 237, 243, 0.92);
}

.snow-arc-c {
    width: 44px;
    height: 5px;
    background-color: rgba(255, 255, 255, 0.88);
}

.snow-chip {
    position: absolute;
    left: 0;
    top: 0;
    width: 14px;
    height: 14px;
    background-color: #f7ffff;
    border-width: 2px;
    border-color: rgba(108, 157, 170, 0.82);
    border-radius: 5px;
    opacity: 0;
}

.snow-chip-b {
    width: 10px;
    height: 10px;
    background-color: #d9edf1;
}

.snow-chip-c {
    width: 16px;
    height: 16px;
    background-color: #ffffff;
}

.snow-chip-d {
    width: 9px;
    height: 9px;
    background-color: #c6e1e7;
    border-width: 1px;
}

.slide-pulse {
    position: absolute;
    left: 16px;
    top: 59px;
    width: 38px;
    height: 38px;
    border-width: 4px;
    border-color: rgba(255, 255, 255, 0.9);
    border-radius: 999px;
    opacity: 0;
}

.cleaned-floor {
    position: absolute;
    left: 4%;
    bottom: 2px;
    width: 0;
    height: 58px;
    background-color: #314a5b;
    border-top-right-radius: 18px;
    border-bottom-right-radius: 18px;
    overflow: hidden;
}

.cleared-road-mark {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 26px;
    height: 5px;
    background-color: rgba(241, 201, 105, 0.76);
}

.clean-sheen {
    position: absolute;
    right: 18px;
    bottom: 45px;
    width: 96px;
    height: 4px;
    background-color: rgba(216, 238, 242, 0.86);
    border-radius: 999px;
    opacity: 0;
}

.clean-glint {
    position: absolute;
    width: 9px;
    height: 9px;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 2px;
    rotate: 45deg;
}

.clean-glint-a {
    left: 27%;
    bottom: 44px;
}

.clean-glint-b {
    left: 56%;
    bottom: 39px;
    width: 7px;
    height: 7px;
}

.clean-glint-c {
    left: 82%;
    bottom: 47px;
    width: 6px;
    height: 6px;
}

.dust-line {
    position: absolute;
    left: 4%;
    bottom: 2px;
    width: 92%;
    height: 50px;
    background-color: #edf6f7;
    border-top-width: 7px;
    border-top-color: #ffffff;
    border-radius: 20px;
    overflow: visible;
}

.snow-ridge {
    position: absolute;
    top: -16px;
    width: 72px;
    height: 42px;
    background-color: #f7ffff;
    border-radius: 999px;
}

.snow-ridge-a {
    left: 8%;
}

.snow-ridge-b {
    left: 44%;
    top: -10px;
    width: 96px;
    height: 46px;
}

.snow-ridge-c {
    right: 6%;
    top: -20px;
    width: 82px;
    height: 48px;
}

.loading-hud {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 62px;
    align-items: center;
}

.loading-kicker {
    margin-bottom: -7px;
    color: #f1c969;
    font-size: 18px;
    letter-spacing: 4px;
    -unity-text-align: middle-center;
}

.loading-title-row {
    width: 880px;
    height: 94px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.loading-title {
    color: #ffffff;
    font-size: 60px;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: #0d2637;
}

.loading-title-dots {
    width: 105px;
    -unity-text-align: middle-left;
}
