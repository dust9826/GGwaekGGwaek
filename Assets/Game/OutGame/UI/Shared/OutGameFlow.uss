.flow-screen {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: #53cbb4;
    overflow: hidden;
    -unity-font-definition: url("../../../Core/UI/Fonts/LilitaOne-Regular.ttf");
}

.float-shape,
.stripe {
    position: absolute;
}

.decor-coral {
    width: 350px;
    height: 350px;
    left: -105px;
    top: -120px;
    background-color: #f1444d;
    border-width: 11px;
    border-color: #ffffff;
    border-radius: 999px;
}

.decor-yellow {
    width: 300px;
    height: 300px;
    right: -95px;
    bottom: -115px;
    background-color: #ffd96b;
    border-width: 11px;
    border-color: #ffffff;
    border-radius: 999px;
}

.decor-ring {
    width: 100px;
    height: 100px;
    right: 9%;
    top: 10%;
    border-width: 16px;
    border-color: #2f83cf;
    border-radius: 999px;
    background-color: rgba(255, 255, 255, 0);
    rotate: 13deg;
}

.stripe {
    width: 390px;
    height: 30px;
    left: -80px;
    bottom: 20%;
    background-color: rgba(255, 255, 255, 0.2);
    border-radius: 18px;
    rotate: -35deg;
}

.flow-card-shadow {
    width: 1080px;
    height: 740px;
    max-width: 84%;
    max-height: 86%;
    min-height: 650px;
    background-color: #249e90;
    border-radius: 12px;
    translate: 12px 16px;
    rotate: 1deg;
}

.flow-card {
    flex-grow: 1;
    align-items: center;
    padding-top: 112px;
    padding-left: 56px;
    padding-right: 56px;
    padding-bottom: 32px;
    background-color: #bdece3;
    border-width: 10px;
    border-color: #ffffff;
    border-radius: 12px;
    translate: -12px -16px;
    rotate: -1deg;
}

.title-banner {
    position: absolute;
    top: -62px;
    width: 820px;
    height: 145px;
    align-items: center;
    justify-content: center;
    background-color: #f1444d;
    border-width: 10px;
    border-color: #ffffff;
    border-radius: 4px;
    rotate: -2deg;
}

.title-text {
    margin-top: 4px;
    color: #ffffff;
    font-size: 58px;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(156, 32, 44, 0.55);
}

.title-kicker {
    margin-top: -2px;
    color: #ffe682;
    font-size: 18px;
    letter-spacing: 2px;
}

.screen-copy {
    color: #173d59;
    font-size: 24px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}

.support-copy {
    margin-top: 5px;
    color: #428478;
    font-size: 17px;
    -unity-text-align: middle-center;
}

.content-row {
    width: 100%;
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.content-column {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.paper-panel {
    padding: 24px;
    background-color: rgba(255, 255, 255, 0.66);
    border-width: 6px;
    border-color: #ffffff;
    border-radius: 9px;
}

.flow-button {
    width: 390px;
    height: 72px;
    margin-top: 7px;
    margin-bottom: 7px;
    color: #ffffff;
    font-size: 30px;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    background-color: #2f83cf;
    border-width: 7px;
    border-color: #ffffff;
    border-bottom-width: 11px;
    border-bottom-color: #1c62a5;
    border-radius: 4px;
}

.flow-button:hover {
    background-color: #44a4ee;
}

.flow-button:active {
    border-bottom-width: 7px;
}

.secondary {
    background-color: #31b478;
    border-bottom-color: #208457;
}

.secondary:hover {
    background-color: #48cf91;
}

.danger {
    background-color: #f05b63;
    border-bottom-color: #be3944;
}

.danger:hover {
    background-color: #ff747b;
}

.yellow {
    color: #173d59;
    background-color: #ffd96b;
    border-bottom-color: #d6aa3e;
}

.yellow:hover {
    background-color: #ffe68f;
}

.compact-button {
    width: 270px;
    height: 64px;
    font-size: 25px;
}

.wide-button {
    width: 460px;
}

.tilt-left {
    rotate: -1.5deg;
}

.tilt-right {
    rotate: 1.5deg;
}

.button-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.field {
    width: 520px;
    margin-top: 10px;
    margin-bottom: 10px;
    color: #173d59;
    font-size: 20px;
}

.field .unity-base-field__label {
    width: 150px;
    min-width: 150px;
    color: #173d59;
    font-size: 19px;
    letter-spacing: 1px;
}

.field .unity-text-input {
    height: 48px;
    padding-left: 14px;
    color: #173d59;
    font-size: 23px;
    background-color: #ffffff;
    border-width: 4px;
    border-color: #2f83cf;
    border-radius: 5px;
}

.status-label {
    min-height: 28px;
    margin-top: 8px;
    padding: 6px 16px;
    color: #428478;
    font-size: 16px;
    letter-spacing: 1px;
    background-color: rgba(255, 255, 255, 0.58);
    border-radius: 18px;
    -unity-text-align: middle-center;
}

.chip {
    padding: 6px 13px;
    color: #ffffff;
    font-size: 15px;
    letter-spacing: 1px;
    background-color: #2f83cf;
    border-radius: 4px;
}

.big-value {
    color: #f1444d;
    font-size: 52px;
    letter-spacing: 7px;
    -unity-text-align: middle-center;
}

.section-title {
    margin-bottom: 8px;
    color: #173d59;
    font-size: 28px;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
}

.footer-note {
    position: absolute;
    right: 22px;
    bottom: 14px;
    color: #428478;
    font-size: 12px;
    letter-spacing: 1px;
}

/* 접속 중 표시. <b>남은 양을 말하지 않는다</b> - 진행 바와 달리 "아직 살아 있다" 만 알린다.
   UI Toolkit 은 @keyframes 가 없으므로 회전은 코드가 돌린다(OutGameScreenController). */
.loading-ring {
    width: 46px;
    height: 46px;
    margin-top: 10px;
    margin-bottom: 4px;
    align-self: center;
    border-radius: 23px;
    border-width: 5px;
    border-top-color: #428478;
    border-right-color: rgba(66, 132, 120, 0.18);
    border-bottom-color: rgba(66, 132, 120, 0.18);
    border-left-color: rgba(66, 132, 120, 0.18);
    transform-origin: center;
}

/* 접속 중 카드는 내용이 적어서 기본 패딩대로 두면 전부 위쪽에 몰린다.
   블록 전체를 카드 세로 중앙에 놓아 고리가 화면 가운데로 온다. */
.connecting-card {
    justify-content: center;
    padding-top: 48px;
}

/* 실패 문구는 평소 상태 표시와 다르게 보여야 한다 - 같은 회색 알약이면 "안내" 로 읽히고
   사람이 그냥 지나친다. 붉은 계열은 이 화면에서 danger 버튼이 이미 쓰는 색이다. */
.status-label.error {
    color: #9c202c;
    background-color: rgba(255, 226, 228, 0.92);
    border-width: 2px;
    border-color: rgba(156, 32, 44, 0.35);
    font-size: 17px;
    white-space: normal;
    max-width: 560px;
}
