/*
 * Santa Village snow-removal theme.
 * Deep winter blue establishes the night shift; snow white keeps information calm;
 * Santa red, pine green and lantern gold are reserved for hierarchy and action.
 */

.flow-screen,
.start-screen {
    background-color: #17384c;
}

/* Legacy decorative hooks are restyled as snow, wind and distant winter light. */
.flow-screen .decor-coral,
.start-screen .blob-coral {
    width: 420px;
    height: 220px;
    left: -130px;
    top: auto;
    bottom: -118px;
    background-color: #edf6f7;
    border-width: 0;
    border-radius: 999px;
    rotate: -5deg;
}

.flow-screen .decor-yellow,
.start-screen .blob-cream {
    width: 330px;
    height: 180px;
    left: auto;
    right: -100px;
    top: auto;
    bottom: -92px;
    background-color: #d8eaee;
    border-width: 0;
    border-radius: 999px;
    rotate: 4deg;
}

.flow-screen .decor-ring,
.start-screen .ring-blue,
.start-screen .ring-yellow {
    width: 11px;
    height: 11px;
    left: auto;
    right: 7%;
    top: 11%;
    bottom: auto;
    background-color: #f4fbfb;
    border-width: 0;
    border-radius: 2px;
    rotate: 45deg;
}

.start-screen .ring-yellow {
    right: 13%;
    top: 17%;
    width: 7px;
    height: 7px;
    opacity: 0.62;
}

.flow-screen > .stripe,
.start-screen .stripe-a {
    width: 470px;
    height: 8px;
    left: -92px;
    right: auto;
    top: 24%;
    bottom: auto;
    background-color: rgba(202, 233, 240, 0.2);
    border-radius: 12px;
    rotate: -9deg;
}

.wipe-trail-secondary {
    position: absolute;
    width: 300px;
    height: 5px;
    right: -48px;
    top: 32%;
    background-color: rgba(230, 247, 249, 0.16);
    border-radius: 12px;
    rotate: -9deg;
}

.start-screen .stripe-b,
.start-screen .stripe-c,
.lower-clean-sparkle,
.footer-note,
.footer-row {
    display: none;
}

.clean-gleam-cluster {
    position: absolute;
    left: 6%;
    bottom: 9%;
    width: 118px;
    height: 92px;
    opacity: 0.68;
}

.clean-gleam,
.lower-clean-sparkle {
    position: absolute;
    background-color: #f7ffff;
    rotate: 45deg;
}

.gleam-large {
    left: 37px;
    top: 18px;
    width: 18px;
    height: 18px;
}

.gleam-small-a {
    left: 7px;
    top: 64px;
    width: 7px;
    height: 7px;
    opacity: 0.55;
}

.gleam-small-b {
    right: 9px;
    top: 3px;
    width: 5px;
    height: 5px;
    opacity: 0.42;
}

/* Frosted dispatch board: straight, quiet and readable. */
.flow-card-shadow,
.menu-card-shadow {
    background-color: #0d2637;
    border-radius: 18px;
    translate: 10px 13px;
    rotate: 0deg;
}

.flow-card,
.menu-card {
    background-color: #eef5f4;
    border-width: 5px;
    border-color: #f9ffff;
    border-bottom-width: 8px;
    border-bottom-color: #b9d5da;
    border-radius: 18px;
    translate: -10px -13px;
    rotate: 0deg;
}

.flow-card {
    padding-top: 104px;
    padding-left: 54px;
    padding-right: 54px;
    padding-bottom: 28px;
}

.flow-card .title-banner,
.start-screen .title-banner {
    top: -48px;
    width: 700px;
    height: 126px;
    background-color: #c73542;
    border-width: 5px;
    border-color: #ffffff;
    border-bottom-width: 9px;
    border-bottom-color: #8f2330;
    border-radius: 14px;
    rotate: 0deg;
}

.flow-card .title-text,
.start-screen .title-text {
    margin-top: 2px;
    color: #ffffff;
    font-size: 54px;
    letter-spacing: 3px;
    -unity-text-outline-width: 0;
}

.flow-card .title-kicker,
.start-screen .title-kicker {
    margin-top: -3px;
    color: #ffe39a;
    font-size: 16px;
    letter-spacing: 2px;
}

.paper-panel,
.mode-group,
.setting-row {
    background-color: rgba(249, 253, 252, 0.94);
    border-width: 2px;
    border-color: #c9dfe3;
    border-bottom-width: 5px;
    border-bottom-color: #a7c4ca;
    border-radius: 11px;
    rotate: 0deg;
}

.paper-panel {
    padding: 22px;
}

.screen-copy,
.section-title,
.mode-label,
.setting-title,
.field,
.field .unity-base-field__label {
    color: #173247;
}

.support-copy,
.mode-copy,
.step-copy {
    color: #557381;
}

.flow-button,
.menu-button {
    color: #ffffff;
    background-color: #c73542;
    border-width: 3px;
    border-color: #ffffff;
    border-bottom-width: 8px;
    border-bottom-color: #8f2330;
    border-radius: 10px;
    rotate: 0deg;
}

.flow-button {
    height: 66px;
    margin-top: 6px;
    margin-bottom: 6px;
    font-size: 27px;
}

.flow-button:hover,
.menu-button:hover {
    background-color: #df4b57;
}

.flow-button:active,
.menu-button:active {
    border-bottom-width: 4px;
}

.secondary {
    background-color: #2f7c66;
    border-bottom-color: #1d5647;
}

.secondary:hover {
    background-color: #3d967d;
}

.danger {
    background-color: #68404c;
    border-bottom-color: #432a35;
}

.danger:hover {
    background-color: #82515f;
}

.yellow {
    color: #173247;
    background-color: #e9bd58;
    border-bottom-color: #b68632;
}

.yellow:hover {
    background-color: #f6d479;
}

.tilt-left,
.tilt-right,
.tilt-left-small,
.tilt-option-left,
.tilt-option-right,
.step-one,
.step-two,
.step-three {
    rotate: 0deg;
}

.compact-button {
    height: 58px;
    font-size: 23px;
}

.field .unity-text-input {
    color: #173247;
    background-color: #ffffff;
    border-width: 2px;
    border-color: #7eacb7;
    border-radius: 8px;
}

.status-label {
    margin-top: 7px;
    padding: 5px 14px;
    color: #456777;
    background-color: rgba(185, 213, 218, 0.28);
    border-radius: 15px;
}

.chip {
    background-color: #2f7c66;
}

.big-value,
.option-value,
.setting-value {
    color: #c73542;
}

.player-row {
    color: #557381;
    background-color: #e3eff0;
    border-left-width: 4px;
    border-left-color: #7eacb7;
    border-radius: 8px;
}

.player-ready {
    color: #173247;
    background-color: #fff0c3;
    border-left-color: #c73542;
}

.selected-option {
    border-width: 3px;
    border-color: #e9bd58;
}

.setting-row {
    height: 116px;
    margin-top: 6px;
    margin-bottom: 6px;
}

.step-number {
    color: #ffffff;
    background-color: #c73542;
    border-width: 3px;
    border-color: #ffffff;
}

/* Start screen keeps the same dispatch-board language. */
.start-screen .menu-card-shadow {
    width: 720px;
    height: 760px;
    max-height: 84%;
    min-height: 650px;
}

.start-screen .menu-card {
    padding-top: 112px;
    padding-left: 62px;
    padding-right: 62px;
    padding-bottom: 38px;
}

.start-screen .subtitle-block {
    margin-top: 18px;
    margin-bottom: 26px;
}

.start-screen .subtitle {
    color: #173247;
    font-size: 31px;
}

.start-screen .support-copy,
.start-screen .status-label {
    display: none;
}

.start-screen .menu-button {
    width: 410px;
    height: 78px;
    margin-top: 9px;
    margin-bottom: 9px;
    font-size: 36px;
}

/* Main menu group hierarchy. */
.main-card {
    width: 960px;
}

.mode-list {
    width: 88%;
}

.mode-group {
    width: 100%;
    height: 196px;
    margin-top: 7px;
    margin-bottom: 7px;
    border-left-width: 5px;
}

.online-group {
    border-left-color: #c73542;
}

.solo-group {
    border-left-color: #2f7c66;
}

.mode-label {
    font-size: 28px;
}

.mode-copy {
    margin-bottom: 7px;
    font-size: 14px;
}

.mode-button {
    width: 320px;
}

.utility-actions {
    margin-top: 5px;
}
