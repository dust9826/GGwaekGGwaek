.start-screen {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: #53cbb4;
    overflow: hidden;
    -unity-font-definition: url("../../../Core/UI/Fonts/LilitaOne-Regular.ttf");
}

.blob,
.ring,
.stripe {
    position: absolute;
}

.blob {
    border-radius: 999px;
}

.blob-coral {
    width: 380px;
    height: 380px;
    left: -110px;
    top: -120px;
    background-color: #f05259;
    border-width: 12px;
    border-color: #ffffff;
}

.blob-cream {
    width: 330px;
    height: 330px;
    right: -90px;
    bottom: -120px;
    background-color: #ffd96b;
    border-width: 12px;
    border-color: #ffffff;
}

.ring {
    width: 115px;
    height: 115px;
    border-radius: 999px;
    border-width: 18px;
    background-color: rgba(255, 255, 255, 0);
}

.ring-blue {
    left: 8%;
    bottom: 12%;
    border-color: #2476c7;
    rotate: -18deg;
}

.ring-yellow {
    right: 10%;
    top: 11%;
    border-color: #ffe680;
    rotate: 14deg;
}

.stripe {
    width: 420px;
    height: 34px;
    background-color: rgba(255, 255, 255, 0.22);
    rotate: -35deg;
    border-radius: 18px;
}

.stripe-a {
    left: -70px;
    bottom: 22%;
}

.stripe-b {
    right: -120px;
    top: 31%;
}

.stripe-c {
    right: 4%;
    bottom: 9%;
    width: 250px;
}

.menu-card-shadow {
    width: 800px;
    height: 940px;
    max-height: 88%;
    min-height: 800px;
    background-color: #249e90;
    border-radius: 12px;
    translate: 12px 16px;
    rotate: 1deg;
}

.menu-card {
    flex-grow: 1;
    align-items: center;
    padding-top: 140px;
    padding-left: 64px;
    padding-right: 64px;
    padding-bottom: 34px;
    background-color: #bdece3;
    border-width: 10px;
    border-color: #ffffff;
    border-radius: 12px;
    translate: -12px -16px;
    rotate: -1deg;
}

.title-banner {
    position: absolute;
    top: -70px;
    width: 700px;
    height: 180px;
    align-items: center;
    justify-content: center;
    background-color: #f1444d;
    border-width: 11px;
    border-color: #ffffff;
    border-radius: 4px;
    rotate: -2deg;
}

.title-text {
    margin-top: 5px;
    color: #ffffff;
    font-size: 72px;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(156, 32, 44, 0.55);
}

.title-kicker {
    margin-top: -4px;
    color: #ffe682;
    font-size: 20px;
    letter-spacing: 2px;
}

.subtitle-block {
    align-items: center;
    margin-bottom: 24px;
}

.subtitle {
    color: #173d59;
    font-size: 34px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}

.support-copy {
    margin-top: 5px;
    color: #428478;
    font-size: 20px;
    -unity-text-align: middle-center;
}

.button-stack {
    width: 100%;
    align-items: center;
    justify-content: center;
}

.menu-button {
    width: 440px;
    height: 100px;
    margin-top: 12px;
    margin-bottom: 12px;
    color: #ffffff;
    font-size: 44px;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    border-width: 8px;
    border-color: #ffffff;
    border-radius: 4px;
    transition-property: background-color;
    transition-duration: 0.12s;
}

.menu-button-primary {
    background-color: #2f83cf;
    border-bottom-width: 13px;
    border-bottom-color: #1c62a5;
}

.menu-button-primary:hover {
    background-color: #44a4ee;
}

.menu-button-secondary {
    background-color: #31b478;
    border-bottom-width: 13px;
    border-bottom-color: #208457;
}

.menu-button-secondary:hover {
    background-color: #48cf91;
}

.menu-button-danger {
    background-color: #f05b63;
    border-bottom-width: 13px;
    border-bottom-color: #be3944;
}

.menu-button-danger:hover {
    background-color: #ff747b;
}

.menu-button:active {
    border-bottom-width: 8px;
}

.tilt-left {
    rotate: -2deg;
}

.tilt-right {
    rotate: 2deg;
}

.tilt-left-small {
    rotate: -1deg;
}

.status-label {
    margin-top: 20px;
    padding: 7px 18px;
    color: #428478;
    font-size: 18px;
    letter-spacing: 2px;
    background-color: rgba(255, 255, 255, 0.58);
    border-radius: 20px;
}

.footer-row {
    position: absolute;
    bottom: 18px;
    left: 20px;
    right: 20px;
    flex-direction: row;
    justify-content: space-between;
}

.footer-chip {
    padding: 5px 10px;
    color: #ffffff;
    background-color: #f1444d;
    font-size: 13px;
    letter-spacing: 1px;
    border-radius: 3px;
}

.footer-chip-blue {
    background-color: #2f83cf;
}
